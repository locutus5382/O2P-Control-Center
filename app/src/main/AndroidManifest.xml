<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Only for user-started, continuously visible gameplay monitoring. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Granted explicitly by the user; used only while a game session is active. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Special Settings access: user must grant in Android Settings; not automatic. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <application
        android:label="O2P Control Center"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".quick.QuickControlActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:screenOrientation="unspecified" />
        <service
            android:name=".quick.ProfileQuickTileService"
            android:label="@string/quick_profile_tile"
            android:icon="@drawable/ic_qs_profile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.SessionQuickTileService"
            android:label="@string/quick_session_tile"
            android:icon="@drawable/ic_qs_session"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Run active recording separately from the UI/Quick Settings process.
             This lets Android discard large UI allocations without necessarily
             terminating the user-started monitoring foreground service. -->
        <provider
            android:name=".monitor.RecordingStatusProvider"
            android:authorities="${applicationId}.monitor.status"
            android:process=":monitor"
            android:exported="false" />
        <service
            android:name=".monitor.GameplayMonitorService"
            android:process=":monitor"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated performance telemetry collection during an active handheld gaming session; stop action in notification" />
        </service>
    </application>
</manifest>
